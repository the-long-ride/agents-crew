{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-crew.dev/schemas/manager-decision.schema.json",
  "title": "Agents Crew Manager Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "should_continue"
  ],
  "properties": {
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "tasks_to_add": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "instructions",
          "role",
          "capabilities",
          "write_scope",
          "dependencies",
          "preferred_workers",
          "expected_output",
          "max_attempts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "manager",
              "planner",
              "researcher",
              "implementer",
              "tester",
              "reviewer",
              "integrator"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write",
                "shell",
                "network",
                "commit",
                "push",
                "deploy",
                "destructive"
              ]
            },
            "uniqueItems": true
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred_workers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "tasks_to_cancel": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "approved",
          "findings"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "approval_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "const": "pending"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "decided_at": {
            "type": "null"
          }
        }
      }
    },
    "should_continue": {
      "type": "boolean"
    },
    "completion_claim": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
